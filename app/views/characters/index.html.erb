<%= render "head"%>
<div class="row">
    <div class="container">
        <%= form_with url: "/characters/search", method: :get do |form| %>
            <%= form.label :query, "Search for:" %>
            <%= form.search_field :query %>
            <%= form.submit "Search" %>
        <% end %>
    </div>
</div>
<% @characters.each do |var| %>
    <div class="row">      
        <h3><b><%= var.name %></b> by, <%= var.username %></h3>
    </div>
    <div class="row">
        <%= link_to "View Details", character_path(var) %>
    </div>
<% end %>
