<%= form_with model: account do |form| %>
    <div class="row">
        <%= form.label :username %>
        <%= form.text_field :username %>
    </div>
    <div class="row">
        <%= form.label :password %>
        <%= form.text_field :password %>
    </div>
    <div class="row">
        <%= form.submit %>
    </div>
<% end %>